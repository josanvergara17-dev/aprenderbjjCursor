# Copia a `.env.local` y rellena. No subas secretos al repo.

# true = auth/vídeos/entregas en memoria (sin Supabase). Ideal para demos locales.
NEXT_PUBLIC_USE_MOCK_AUTH=true

# true = si la BD no tiene técnicas, usar grafo estático TS (solo dev/demo).
# NEXT_PUBLIC_USE_STATIC_GRAPH_FALLBACK=true

# Proyecto Supabase (Dashboard → Settings → API). Solo necesarios si USE_MOCK_AUTH=false.
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key

# Webhook Mux → actualiza technique_videos (service role, solo servidor).
# SUPABASE_SERVICE_ROLE_KEY=

# Mux — clases oficiales (HLS adaptativo). Dashboard → Settings → Access Tokens.
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_WEBHOOK_SECRET=

# Webhook URL en Mux: https://TU_DOMINIO/api/webhooks/mux
