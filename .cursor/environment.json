{
  "name": "No-Gi Lab",
  "install": "pnpm install && (test -f .env.local || cp .env.example .env.local)",
  "terminals": [
    {
      "name": "Next.js",
      "command": "pnpm dev --hostname 0.0.0.0 --port 3000",
      "description": "Dev server on 0.0.0.0:3000 for Cloud Agent port forwarding / preview"
    }
  ],
  "ports": [
    {
      "name": "web",
      "port": 3000
    }
  ]
}
